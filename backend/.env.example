# ==========================================
# BACKEND ENVIRONMENT VARIABLES - Supabase
# ==========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file with production values!

# Server Configuration
PORT=8080

# Database Configuration - Supabase PostgreSQL
# Get from Supabase Project Settings -> Database
# Format: postgres://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:trannguyenphu125@db.bhufnlndpxfcjagzmjrs.supabase.co:5432/postgres

# CORS Configuration
# Comma-separated list of allowed origins
# For local: http://localhost:5173,http://localhost:5174
# For production: https://hackagame.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://YOUR_NETLIFY_SITE.netlify.app

# Environment
ENVIRONMENT=production
