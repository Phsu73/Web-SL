# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file with production values!

# Server Configuration
PORT=8080

# Database Configuration
# For local development: ./hackathon-game.db
# For Railway: /data/hackathon-game.db
# For Render: /opt/render/project/backend/data/hackathon-game.db
DB_PATH=./hackathon-game.db

# CORS Configuration
# Comma-separated list of allowed origins
# For local: http://localhost:5173,http://localhost:5174
# For production: https://hackagame.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://hackagame.netlify.app

# Environment
ENVIRONMENT=development
