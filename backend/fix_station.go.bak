package main

import (
	"database/sql"
	"fmt"
	"log"

	_ "modernc.org/sqlite"
)

func main() {
	db, err := sql.Open("sqlite", "./hackathon-game.db")
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()

	// Update team 2 to have current station 1
	_, err = db.Exec("UPDATE checkpoints SET atStation = 1 WHERE team_id = 2")
	if err != nil {
		log.Fatal(err)
	}

	fmt.Println("Updated team 2 to have current station 1")

	// Verify
	var atStation int
	err = db.QueryRow("SELECT atStation FROM checkpoints WHERE team_id = 2").Scan(&atStation)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("Team 2 current station: %d\n", atStation)
}
